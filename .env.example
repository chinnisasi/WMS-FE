# wms-fe environment
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# Story 6-2a — a deployed image reads these at RUN time instead (one image,
# every environment): the browser's API base, served as /runtime-config.js,
# and optionally the base the web server's own requests use.
# WMS_API_BASE_URL=https://api.example.in/api/v1
# WMS_API_INTERNAL_BASE_URL=http://api:3000/api/v1
# Story 6-2c — the image's start bounds Next's SIGTERM drain: past this many
# ms it exits 75 (default 25000; a positive integer, or the start refuses with
# exit 78). The orchestrator's stop timeout must be at least this + 5 s.
# WEB_SHUTDOWN_FORCE_EXIT_MS=25000
