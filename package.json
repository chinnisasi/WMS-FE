{
  "name": "wms-fe",
  "version": "0.1.0",
  "private": true,
  "description": "WMS web dashboard \u2014 Next.js 16 App Router shell with the shared design-token layer",
  "workspaces": [
    "mobile"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "packageManager": "bun@1.2.20",
  "scripts": {
    "preinstall": "node -e \"if (!/^bun\\//.test(process.env.npm_config_user_agent || '')) { console.error('This repo uses bun only \u2014 run bun install (never npm/yarn/pnpm).'); process.exit(1); }\"",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-ts"
  },
  "dependencies": {
    "@hey-api/client-fetch": "0.13.1",
    "geist": "1.7.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.30.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "bun-types": "1.4.2",
    "eslint": "9.30.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
